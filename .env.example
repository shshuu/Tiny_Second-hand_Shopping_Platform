# Local Docker Compose demonstration only. Generate a value before first start:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
COMPOSE_PROJECT_NAME=tinysecondhand
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# Localhost-only DEBUG=false demonstration mode. Never expose this mode to a network.
DJANGO_LOCAL_DEMO_MODE=true
# Local demo only: Django may serve sanitized images. Production must use false.
SERVE_MEDIA_LOCALLY=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set true only behind a trusted TLS proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUSTED_PROXY=false
# Comma-separated HTTPS origins only in production; leave blank for local development.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Development host port. If 8000 is busy, use a free value such as 18000.
WEB_PORT=8000

# Local Compose URLs. Replace all development credentials for production.
DATABASE_URL=postgresql://tiny:tiny@db:5432/tiny_market
REDIS_URL=redis://redis:6379/1

# Local demonstration grant: this creates an append-only WELCOME_BONUS
# transaction and ledger entry after the wallet starts at 0P.  Set false in
# deployments that do not offer a signup promotion.
WELCOME_BONUS_ENABLED=true
WELCOME_BONUS_AMOUNT=10000

# Transfer and administrator grant limits: positive integers, maximum 1,000,000,000.
TRANSFER_MAX_AMOUNT=10000
TRANSFER_DAILY_LIMIT=50000
ADMIN_GRANT_MAX_AMOUNT=100000
ADMIN_GRANT_DAILY_LIMIT=500000

# Per-minute limits: positive integers, maximum 10,000.
TRANSFER_RATE_LIMIT_PER_MINUTE=5
ADMIN_GRANT_RATE_LIMIT_PER_MINUTE=5
CHAT_RATE_LIMIT_PER_MINUTE=30

# Automatic moderation counts distinct active reporters only.
AUTO_MODERATION_ENABLED=true
AUTO_HIDE_PRODUCT_REPORT_THRESHOLD=3
AUTO_RESTRICT_USER_REPORT_THRESHOLD=5

# Redis fixed-window TTL: positive integer, 1..300 seconds.
RATE_LIMIT_TTL_SECONDS=70

# Administrator login fixed-window limit and TTL (1..100 attempts; 1..300 seconds).
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
ADMIN_LOGIN_RATE_LIMIT_TTL_SECONDS=60

# Public signup: IP hash counter; positive limit (1..100), window 1..86,400 seconds.
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=600

# Public login failures: account+IP and IP-hash counters; window 1..86,400 seconds.
LOGIN_FAILURE_RATE_LIMIT=5
LOGIN_FAILURE_IP_RATE_LIMIT=20
LOGIN_FAILURE_RATE_LIMIT_WINDOW_SECONDS=300

# Administrator session/re-authentication policy in seconds.
ADMIN_SESSION_IDLE_SECONDS=900
ADMIN_SESSION_ABSOLUTE_SECONDS=28800
ADMIN_REAUTH_SECONDS=300
